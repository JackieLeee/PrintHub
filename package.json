{
  "name": "virt-printer-hub",
  "private": true,
  "scripts": {
    "dev": "pnpm build:web && pnpm --filter @virt-printer/bridge dev",
    "dev:bridge": "pnpm --filter @virt-printer/bridge dev",
    "dev:web": "pnpm --filter @virt-printer/web dev",
    "build:web": "pnpm --filter @virt-printer/web build",
    "start": "pnpm build:web && pnpm --filter @virt-printer/bridge start",
    "build": "turbo build",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9"
}
