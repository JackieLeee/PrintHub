{
  "name": "@virt-printer/desktop",
  "private": true,
  "version": "1.1.0",
  "description": "PrintHub desktop app (Electron)",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node scripts/rename-preload.mjs",
    "install:electron": "node scripts/ensure-electron.mjs",
    "postinstall": "node scripts/ensure-electron.mjs --soft",
    "icons": "node scripts/generate-app-icon.mjs",
    "dev": "pnpm build && node scripts/run-dev.mjs",
    "dev:raw": "pnpm build && node scripts/run-electron.mjs",
    "start": "pnpm build && node scripts/run-dev.mjs",
    "pack": "pnpm icons && pnpm build && electron-builder --dir",
    "dist": "pnpm icons && pnpm build && pnpm exec electron-builder --mac dmg --arm64 --x64",
    "dist:mac": "pnpm icons && pnpm build && pnpm exec electron-builder --mac dmg --arm64 --x64",
    "dist:ci": "pnpm build && pnpm exec electron-builder install-app-deps && pnpm exec electron-builder --mac dmg --arm64 --x64",
    "dist:win": "pnpm icons && pnpm build && pnpm exec electron-builder --win nsis"
  },
  "dependencies": {
    "@virt-printer/bridge": "workspace:*",
    "@virt-printer/shared": "workspace:*",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "dev.printhub.desktop",
    "productName": "PrintHub",
    "npmRebuild": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg"],
      "icon": "icon.icns",
      "identity": null,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "x64ArchFiles": "**/node_modules/{@img,sharp}/**",
      "extendInfo": {
        "CFBundleName": "PrintHub",
        "CFBundleDisplayName": "PrintHub"
      }
    },
    "win": {
      "icon": "icon.png",
      "target": ["nsis"]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
